NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the seeded demo accounts (npm run seed:demo). Server-side only.
DEMO_ACCOUNT_PASSWORD=choose-a-long-random-password

# Protects /api/cron/reset-demo (nightly demo reset, see vercel.json). Vercel Cron sends it automatically.
CRON_SECRET=generate-a-long-random-string
